DATABASE_URL=postgresql://user:password@localhost:5432/aos_db
PORT=3000
FRONTEND_URL=http://localhost:5173

# AWS — use SSO profile or explicit keys
AWS_REGION=ap-southeast-1
AWS_PROFILE=your-sso-profile
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Cognito
COGNITO_USER_POOL_ID=ap-southeast-1_xxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SES
AWS_SES_FROM_EMAIL=noreply@yourdomain.com
