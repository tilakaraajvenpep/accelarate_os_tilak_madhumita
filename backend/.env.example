PORT=3000

# AWS profile used to fetch config from Secrets Manager (local dev only —
# Lambda uses its execution role instead of a profile)
AWS_PROFILE=your-sso-profile
AWS_REGION=ap-southeast-1

# All real config (DATABASE_URL, Cognito, BASE_DOMAIN, ADMIN_URL, SES,
# seed-superadmin credentials) lives in this Secrets Manager secret as a JSON
# blob — see src/config/load-secrets.ts. Nothing secret belongs in .env.
SECRETS_NAME=aos-v2/dev/backend

# Subdomain-based tenant routing (code-only for now — see plan). BASE_DOMAIN
# drives CORS origin matching for {slug}.BASE_DOMAIN / admin.BASE_DOMAIN /
# BASE_DOMAIN itself. ADMIN_URL is where super-admin-facing redirects (e.g.
# Stripe checkout) land.
BASE_DOMAIN=localhost
ADMIN_URL=http://admin.localhost:5173
