PORT=3000

# AWS profile used to fetch config from Secrets Manager (local dev only —
# Lambda uses its execution role instead of a profile)
AWS_PROFILE=your-sso-profile
AWS_REGION=ap-southeast-1

# All real config (DATABASE_URL, Cognito, FRONTEND_URL, SES, seed-superadmin
# credentials) lives in this Secrets Manager secret as a JSON blob — see
# src/config/load-secrets.ts. Nothing secret belongs in .env.
SECRETS_NAME=aos-v2/dev/backend
